---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
const projects = [
  {
    name: "片场侦探",
    category: "GAME / 游戏",
    description: "电影之外，再来一场游戏。",
    url: "https://go.moviewikia.com",
  },
  {
    name: "Movie Wikia",
    category: "FILM / 电影",
    description: "记住电影，收藏光影里的故事。",
    url: "https://moviewikia.com?utm_source=oscar&utm_medium=blog",
  },
  {
    name: "Lexiclip",
    category: "LEARNING / 学习",
    description: "记住单词，让每一次阅读都有收获。",
    url: "https://lexiclip.com?utm_source=oscar&utm_medium=blog",
  },
];
---

<Layout title={`作品 | ${SITE.title}`}>
  <Header />
  <Main>
    <div class="page-intro">
      <span class="eyebrow">Things I make</span>
      <h1>一些想法，做成了作品。</h1>
      <p>关于学习、电影，以及一点好玩的东西。</p>
    </div>
    <div>
      {
        projects.map((project) => (
          <a
            class="project-row"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <>
              <div>
                <>
                  <span class="eyebrow">{project.category}</span>
                  <h2>{project.name}</h2>
                  <p>{project.description}</p>
                </>
              </div>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
      <div class="project-row">
        <div>
          <span class="eyebrow">WECHAT / 小程序</span><h2>看图猜电影</h2><p>
            凭一张画面，认出一部电影。
          </p><img
            src="/assets/img/guess_movie.png"
            width="120"
            height="120"
            alt="微信扫描，打开看图猜电影小程序"
            class="mt-5"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>
