---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={[
    "app-layout site-footer",
    { "site-footer-paged": noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="site-footer-inner">
    <span>© {new Date().getFullYear()} Oscar</span><Socials />
  </div>
</footer>
