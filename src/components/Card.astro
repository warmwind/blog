---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const {
  title,
  originalUrl,
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
} = data;

const isModified = modDatetime && modDatetime > pubDatetime;
const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone || SITE.timezone,
);
const formattedDate = datetime.format("YYYY/MM/DD");
const href = getPath(id, filePath);
---

<li class="post-row">
  <time class="post-date" datetime={datetime.toISOString()}
    >{formattedDate}</time
  >
  <div>
    <a href={href} class="post-link">
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        >{title}</Heading
      >
    </a>
    {
      originalUrl && (
        <a
          href={originalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="post-source"
          aria-label={`阅读原文：${title}`}
        >
          原文 ↗
        </a>
      )
    }
  </div>
</li>
