---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter((p) => p.trim());
  const pathArray = path.split("/").filter((p) => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
  >跳到正文</a
>
<header class="app-layout site-header">
  <div class="site-header-inner">
    <a href="/" class="site-name"
      >{SITE.title}<span class="text-accent">.</span></a
    >
    <nav class="site-nav" aria-label="主导航">
      <a
        href="/"
        class:list={{
          "active-nav": currentPath === "/" || /^\/\d+$/.test(currentPath),
        }}
        aria-current={currentPath === "/" ? "page" : undefined}>文章</a
      >
      <a
        href="/soccer"
        class:list={{ "active-nav": isActive("/soccer") }}
        aria-current={isActive("/soccer") ? "page" : undefined}>足球</a
      >
      <a
        href="https://moviewikia.com?utm_source=oscar&utm_medium=blog"
        target="_blank"
        rel="noopener noreferrer">影视 ↗</a
      >
      <a
        href="/apps"
        class:list={{ "active-nav": isActive("/apps") }}
        aria-current={isActive("/apps") ? "page" : undefined}>作品</a
      >
      <a
        href="/about"
        class:list={{ "active-nav": isActive("/about") }}
        aria-current={isActive("/about") ? "page" : undefined}>关于</a
      >
      <a href="/search" class="site-tool" aria-label="搜索文章"
        ><IconSearch /></a
      >
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="site-tool relative"
            title="切换明暗主题"
            aria-label="auto"
            aria-live="polite"
          >
            <>
              <IconMoon class="absolute dark:hidden" />
              <IconSunHigh class="absolute hidden dark:block" />
            </>
          </button>
        )
      }
    </nav>
  </div>
</header>
